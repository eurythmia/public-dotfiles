# #!/usr/bin/perl
snippet #!
	#!/usr/bin/perl
	use strict;
	use warnings;
	
	use 5.28.1;

	use Getopt::Long::Descriptive;
	use Params::Validate qw/:all/;
	use Module::Implementation;
	use Module::Runtime;
	use Data::Dump;
	use Try::Tiny;
	use Sub::Exporter;
	use Data::OptList;
	use Params::Util;
	use Sub::Install;
	use Date::Time;

	( my $script_name = __FILE__ ) =~ s#.*/##;

	my ( $opts, $usage ) = describe_options( "%c %o",
		[],
		['Description'],
		[],
		[' Usage '],
		['-------'],
		[ 'help|h',   'Display usage message and exit.', {shortcircuit => 1} ],
		[ 'parse|p',  'Parse latex files', {required => 1} ],
		[],
		[' Examples '],
		['----------'],
		["1. $script_name -p"],
		["  parses latex files and updates the blog using cache."],
		["2. $script_name -bp"],
		["  parses latex files and updates the blog without cache."]
	);

	if ($opts->help) {
		print($usage->text);
		exit;
	}

	dispatch($opts);

	### Subs ###
	sub dispatch {
		my ($opts) = validate_pos( @_, { isa => 'Getopt::Long::Descriptive::Opts' }); 

		return debug()
			if $opts->debug;

			return;
	}
# Hash Pointer
snippet .
	 =>
# read
snippet read
	sub read_file {
		my $file = shift;
		undef $/; # Slurp mode.
		my $fh = new IO::File($file, 'r');
		my $data = <$fh> if defined $fh;
		undef $fh; # Close the file.
		return $data;
	}
# Pipe
snippet run
	sub run_cmd {
		my ($cmd) = validate_pos(@_, { type => SCALAR });

		local $| = 1;

		my $pipe = IO::Pipe->new();
		$pipe->reader($cmd);

		while (<$pipe>) {
			next unless $_;
			print;
		}

		undef $pipe;
	}
# Function
snippet sub
	sub ${1:function_name} {
		my ($${2:var}) = validate_pos( @_, { type => ${3:HASHREF} } );

		${4:#body ...}
	}
# New
snippet new
	sub new {
		my $proto = shift;

		my $val = { ${1:key} => { regex => qr/^(${2:})$/, required => 1 },
					${3:key} => { type => ${4:SCALAR}, optional => 1 },
					log_file => { type => SCALAR, optional => 1 }  };

		my $hashref = validate( @_, $val );

		my $class = ref($proto) || $proto;
		my $self = bless( $hashref, $class );
		$self->get_file_handles;
		return $self->_init;
	}

	sub _init {
		my $self = shift;
		return $self;
	}
	
	sub _get_file_handles {
		my $self = shift;

		unless ( $self->{log_fh} ) {
			$self->{log_fh} = defined $self->{log_file}
				?  IO::File->new($self->{log_file}, 'a')
				: \*STDOUT;

			die "Can't open log file '$self->{log_file}': $!\n"
				unless $self->{log_fh};
				
			$self->{log_fh}->autoflush(1);
		}

		return $self;
	}

	sub app_log {
		my $self = shift;
		my ($type, $message) = validate_pos(@_, {type => SCALAR }, {type => SCALAR } ); 
		my $dt = DateTime->now();

		my $caller = (caller(1))[3] || sprintf('%s::main', caller);
		my $msg_type = sprintf('%s_msg', lc $type);
		push @{ $self->{msg_type} }, $message;

		my $fh = $self->{log_fh}; # Can't write directly to $self->{log_fh} for some reason.

		say $fh sprintf('%s|%s|%s %s', $type, $caller, $message, $dt->ymd, $dt->hms)
			unless $type eq 'INFO';

		return $self;
	}
# Conditional
snippet if
	if (${1}) {
		${2:# body...}
	}
# Conditional if..else
snippet ife
	if (${1}) {
		${2:# body...}
	}
	else {
		${3:# else...}
	}
# Conditional if..elsif..else
snippet ifee
	if (${1}) {
		${2:# body...}
	}
	elsif (${3}) {
		${4:# elsif...}
	}
	else {
		${5:# else...}
	}
# Conditional One-line
snippet xif
	${1:expression} if ${2:condition};${3}
# Unless conditional
snippet unless
	unless (${1}) {
		${2:# body...}
	}
# Unless conditional One-line
snippet xunless
	${1:expression} unless ${2:condition};${3}
# Try/Except
snippet eval
	eval {
		${1:# do something risky...}
	};
	if ($@) {
		${2:# handle failure...}
	}
# While Loop
snippet wh
	while (${1}) {
		${2:# body...}
	}
# While Loop One-line
snippet xwh
	${1:expression} while ${2:condition};${3}
# C-style For Loop
snippet cfor
	for (my $${2:var} = 0; $$2 < ${1:count}; $$2${3:++}) {
		${4:# body...}
	}
# For loop one-line
snippet xfor
	${1:expression} for @${2:array};${3}
# Foreach Loop
snippet for
	foreach my $${1:x} (@${2:array}) {
		${3:# body...}
	}
# Foreach Loop One-line
snippet fore
	${1:expression} foreach @${2:array};${3}
# Package
snippet cl
	package ${1:ClassName};

	use base qw(${2:ParentClass});

	sub new {
		my $class = shift;
		$class = ref $class if ref $class;
		my $self = bless {}, $class;
		$self;
	}

	1;${3}
# Read File
snippet slurp
	my $${1:var} = do { local $/; open my $file, '<', "${2:file}"; <$file> };
	${3}
